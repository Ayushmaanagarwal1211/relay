# Copy this file to .env:  cp .env.example .env
# Every value here is for the local Docker containers in docker-compose.yml.
# No real accounts or API keys are needed.

PORT=3000

# Postgres (user/password/db match docker-compose.yml)
DATABASE_URL=postgres://relay:relay@localhost:5432/relay
TEST_DATABASE_URL=postgres://relay:relay@localhost:5432/relay_test

# RabbitMQ (dashboard: http://localhost:15672, login relay / relay)
RABBITMQ_URL=amqp://relay:relay@localhost:5672

# Mailpit, the fake email server (inbox: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=Relay <no-reply@relay.local>

# Outbox relay
RELAY_POLL_INTERVAL_MS=500
RELAY_BATCH_SIZE=100

# Worker
# Wait before each retry: 10s, 1m, 5m. Three delays = up to 4 attempts, then the dead-letter queue.
RETRY_DELAYS_MS=10000,60000,300000
WORKER_PREFETCH=10
SENDING_LEASE_MS=60000
WORKER_QUEUES=transactional,promotional

# Used from step 4 (rate limiting)
REDIS_URL=redis://localhost:6379
